# CTF-Agent 环境变量配置
# 复制此文件为 .env 并填入实际值

# === LLM配置 ===
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
LLM_MODEL=qwen3.6-plus
# LLM_TIMEOUT=120

# === 比赛平台配置 ===
COMPETITION_SERVER_HOST=
COMPETITION_AGENT_TOKEN=
# COMPETITION_MCP_URL=

# === 比赛专用 ===
# 比赛环境大模型网关（开启答题模式时取消注释）
# COMPETITION_LLM_BASE_URL=http://10.0.0.24/75_fv2dfe85

# === 超时配置（秒）===
# TASK_TIMEOUT=1800

# === Advisor Agent 配置（可选）===
# ADVISOR_ENABLED=true
# ADVISOR_EVALUATE_INTERVAL=3
# ADVISOR_COMPRESS_INTERVAL=15
