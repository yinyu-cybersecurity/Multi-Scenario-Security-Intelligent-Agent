{
  "model": {
    "name": "qwen3.6-plus",
    "base_url": "https://coding.dashscope.aliyuncs.com/v1",
    "api_key": "${LLM_API_KEY}",
    "timeout": 120,
    "temperature": 0.6,
    "fallback_models": []
  },

  "timeouts": {
    "task": 1800,
    "tool_default": 300,
    "llm_call": 120,
    "mcp_connect": 30
  },

  "retry": {
    "max_retries": 3,
    "base_delay": 1.0,
    "max_delay": 30.0
  },

  "competition": {
    "server_host": "${COMPETITION_SERVER_HOST}",
    "agent_token": "${COMPETITION_AGENT_TOKEN}",
    "mcp_url": "",
    "rate_limit": 0.35,
    "max_concurrent_instances": 3
  },

  "query": {
    "max_turns": 500,
    "context_window_tokens": 262144,
    "context_reserve_tokens": 8192,
    "message_truncate_threshold": 16000,
    "parallel_tool_calls": true
  },

  "mcp_servers": {
    "kali": {
      "command": ".venv/bin/python3",
      "args": ["mcp_servers/kali_server.py"],
      "env": {}
    }
  }
}
