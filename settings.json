{
  "$schema": "./settings.schema.json",

  "model": {
    "provider": "openai",
    "name": "glm-5",
    "base_url": "https://open.bigmodel.cn/api/paas/v4/",
    "api_key": "${LLM_API_KEY}",
    "timeout": 120,
    "max_retries": 3,
    "max_concurrent": 5
  },

  "timeouts": {
    "ctf_single": 1800,
    "ctf_multi": 3600,
    "external_attack": 3600,
    "internal_penetration": 7200,
    "full_penetration": 10800
  },

  "tools": {
    "native_execution": true,
    "venv_path": "~/.ctf_agent/venv",
    "timeout_multiplier": 1.0,
    "dangerous_commands_require_confirmation": true
  },

  "mcp_servers": {
    "semgrep": {
      "command": "uvx",
      "args": ["semgrep-mcp-server"],
      "env": {}
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@context7/mcp-server"],
      "env": {}
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-playwright"],
      "env": {}
    },
    "openspace": {
      "command": "D:/LangGraph2.0/langGraph/deploy/venv312/Scripts/openspace-mcp.exe",
      "args": [],
      "env": {
        "OPENSPACE_HOST_SKILL_DIRS": "D:/LangGraph2.0/langGraph/deploy/skills",
        "OPENSPACE_WORKSPACE": "D:/LangGraph2.0/langGraph/deploy/OpenSpace-main",
        "OPENSPACE_API_KEY": "${OPENSPACE_API_KEY}"
      }
    }
  },

  "skills": {
    "enabled": true,
    "auto_recommend": true,
    "lazy_load": true,
    "skills_dir": "app/skills/data"
  },

  "memory": {
    "enabled": true,
    "persist_token_stats": true,
    "prompt_cache_ttl": 3600
  },

  "frontend": {
    "ws_url": "ws://localhost:8000/ws",
    "pulse_animation": true,
    "decision_flow_display": true
  },

  "competition": {
    "server_host": "${COMPETITION_SERVER_HOST}",
    "agent_token": "${COMPETITION_AGENT_TOKEN}",
    "rate_limit_delay": 0.35
  },

  "logging": {
    "level": "INFO",
    "file": "logs/ctf_agent.log",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  }
}